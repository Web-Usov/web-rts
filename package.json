{
  "name": "web-rts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test && pnpm test:kb",
    "test:simulation": "turbo run test --filter=@web-rts/scenario-runner",
    "test:server": "turbo run test:integration --filter=@web-rts/game-server",
    "test:e2e": "playwright test",
    "test:docker-smoke": "node scripts/docker-lan-smoke.mjs",
    "typecheck": "turbo run typecheck && tsc -p tests/e2e/tsconfig.json",
    "lint": "turbo run lint && eslint tests/e2e/browser-*.ts tests/e2e/helpers/browser-*.ts && prettier --check .",
    "format": "prettier --write .",
    "verify:gameplay": "pnpm --silent exec turbo run build --filter=@web-rts/scenario-runner > /dev/null && node tools/scenario-runner/dist/cli.js",
    "kb": "node scripts/knowledge-base.mjs",
    "test:kb": "node --test scripts/knowledge-base.test.mjs",
    "verify:mutation": "pnpm --silent exec turbo run build --filter=@web-rts/scenario-runner > /dev/null && node tools/scenario-runner/dist/mutation-cli.js",
    "verify:browser": "playwright test tests/e2e/browser-replay.spec.ts tests/e2e/browser-evidence.spec.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "turbo": "^2.11.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^22.20.4"
    }
  }
}
