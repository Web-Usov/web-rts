# Host port for the static web client.
WEB_PORT=5173

# Host port published for the Colyseus game server.
GAME_SERVER_PORT=2567

# Optional browser-visible override, for example:
# GAME_SERVER_URL=http://192.168.1.50:2567
# Leave empty to use the same hostname that served the web page plus GAME_SERVER_PORT.
GAME_SERVER_URL=
