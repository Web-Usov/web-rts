# Host port for the static web client.
# LAN URL: http://<docker-host-lan-ip>:WEB_PORT
WEB_PORT=5173

# Host port published for the game server.
# The container still listens on 2567. Without GAME_SERVER_URL, the browser
# connects to the page hostname and this port.
GAME_SERVER_PORT=2567

# Optional explicit browser-visible game-server URL (reverse proxy, DNS, or
# another public endpoint). Leave unset so a LAN client uses the page hostname
# plus GAME_SERVER_PORT.
# GAME_SERVER_URL=https://game.example.com
