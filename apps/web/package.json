{
  "name": "@web-rts/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.meshy.json --noEmit",
    "test": "vitest run && node --test meshy/tests/*.test.js",
    "lint": "eslint .",
    "dev": "vite",
    "build:meshy": "vite build --config vite.meshy.config.ts"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^9.29.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@web-rts/testkit": "workspace:^",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "5",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@babylonjs/core": "^9.28.0",
    "@colyseus/sdk": "^0.18.4",
    "@web-rts/game-data": "workspace:^",
    "@web-rts/match-adapter": "workspace:^",
    "@web-rts/protocol": "workspace:^",
    "@web-rts/simulation": "workspace:^",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  }
}
